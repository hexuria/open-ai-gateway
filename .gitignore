/target
**/*.rs.bk
.env
.env.local
/data
/web/node_modules
/web/dist
.DS_Store

# OpenTofu / Terraform local state and provider downloads
.terraform/
# `.terraform.lock.hcl` is NOT ignored — it is committed, deliberately.
#
# Provider constraints here are `~> N`, which floats within a major. Without the
# lock file a fresh clone resolves whichever minor is newest that day, so two
# operators on the same commit get different plans and one of them is surprised.
# The lock is what makes a commit mean one thing.
*.tfstate
*.tfstate.*

# Local deploy answers (holds secrets) written by deploy/tofu/deploy-gcp.sh
deploy/tofu/gcp-deploy.local.env

# Dev API keys minted by `just api-keys`, for the hurl files in
# deploy/test/api. Shown once at creation; this file holds the only copy.
.dev-hurl-vars
