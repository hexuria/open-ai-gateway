# Edge tier: TLS termination and the admin UI. Internal network only —
# this gateway is not meant to face the public internet, which is why there is
# no WAF, no IP reputation, and no challenge page here.
#
# Everything in this file that looks fussy is about one thing: not breaking
# server-sent events. See docs/01-deployment.md §The seven traps.

{
	servers {
		max_header_size 64KB
		timeouts {
			read_header 10s
			# Long, because an idle-but-alive stream is normal here. This is a
			# connection-level idle timeout, not a response deadline.
			idle 5m
		}
	}
}

gateway.internal {
	tls internal

	# ── inference ──────────────────────────────────────────────────────────────
	# Everything under the API paths goes to the load balancer, which fans out
	# across gateway replicas.
	@inference path /v1/* /v1beta/* /chat/* /responses* /embeddings*
	handle @inference {
		reverse_proxy envoy:10000 {
			# Caddy detects text/event-stream and flushes immediately, so
			# flush_interval is deliberately left unset. Setting it to -1 forces
			# immediate flushing for *every* response, which also disables the
			# response-buffering that non-streaming JSON benefits from.
			transport http {
				keepalive 5m
				keepalive_idle_conns 256
				# Never compress toward the load balancer: it would buffer.
				compression off
				# No response deadline. A completion legitimately runs minutes.
				read_timeout 0
				write_timeout 0
			}
			header_up X-Forwarded-Proto {scheme}
			header_up X-Real-IP {remote_host}
		}
	}

	# ── admin UI and API ───────────────────────────────────────────────────────
	# Separate upstream port. The load balancer never sees admin traffic, and
	# the admin listener is never reachable from the inference path.
	handle {
		reverse_proxy oag-1:8081
	}

	# ── compression ────────────────────────────────────────────────────────────
	# An allow-list of concrete content types, never `text/*`.
	#
	# This is the trap that bites everyone: `text/event-stream` matches `text/*`,
	# and a compressed SSE stream is buffered until the stream ends — so the
	# client sees nothing for two minutes and then everything at once. It looks
	# exactly like a hung backend.
	encode {
		zstd
		gzip 6
		minimum_length 512
		match {
			header Content-Type application/json*
			header Content-Type application/javascript*
			header Content-Type text/css*
			header Content-Type text/html*
		}
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		-Server
	}

	log {
		output stdout
		format json
	}
}
